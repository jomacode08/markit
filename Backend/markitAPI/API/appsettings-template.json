{
  // Demonstrative values
  "ConnectionStrings": {
    "ConnectionString": ""
  },
  "SpaSettings": {
    "baseUrl": ""
  },
  "JwtSettings": {
    "Key": "",
    "Issuer": "Markit",
    "Audience": "Markit Users",
    "AccessTokenDurationInMinutes": 60,
    "RefreshTokenDurationInMinutes": 10080
  },
  "RateLimiting": {
    "VolumeControl": {
      "PermitLimit": 100,
      "WindowMinutes": 1,
      "WindowSegments": 4
    },
    "ConcurrencyControl": {
      "PermitLimit": 20,
      "QueueLimit": 10    
    },
    "DemoLoginQuota": {
      "PermitLimit": 5,
      "WindowHours": 1
    }
  },
  "UserDefaultSettings": {
    "UserName": "",
    "Password": ""
  },
  "GoogleAuthSettings": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "GitHubAuthSettings": {
    "AppName": "",
    "ClientId": "",
    "ClientSecret": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/applog-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "ApplicationName": "Markit API"
    }
  }
}