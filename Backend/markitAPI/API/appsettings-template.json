{
  "ConnectionStrings": {
    "ConnectionString": ""
  },
  "DemoSettings": {
    "Enabled": false
  },
  "SpaSettings": {
    "baseUrl": ""
  },
  "JwtSettings": {
    "Key": "",
    "Issuer": "Markit",
    "Audience": "Markit Users",
    "AccessTokenDurationInMinutes": 60,
    "RefreshTokenDurationInMinutes": 10080
  },
  "UserDefaultSettings": {
    "Id": "",
    "FirstName": "Markit",
    "LastName": "Admin",
    "UserName": "",
    "Password": ""
  },
  "GoogleAuthSettings": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "GitHubAuthSettings": {
    "AppName": "",
    "ClientId": "",
    "ClientSecret": ""
  },
  "MeiliSearchSettings": {
    "UrlServer": "",
    "ApiKey": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/applog-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "ApplicationName": "Markit API"
    }
  }
}