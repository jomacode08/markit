{
  // Database connection string for PostgreSQL
  // Example (Docker): "Host=localhost;Port=5432;Database=markitdb;Username=postgres;Password=postgres"
  // Can be Auto-filled by setup script
  "ConnectionStrings": {
    "ConnectionString": ""
  },
  // Frontend application URL for CORS configuration
  // Default: "http://localhost:4200"
  // Can be auto-filled by setup script
  "SpaSettings": {
    "baseUrl": ""
  },
  // JWT authentication settings
  // Key: Required - minimum 32 characters, 64+ recommended
  // Generate with: ./scripts/generate-jwt-key.ps1 or ./scripts/generate-jwt-key.sh
  // Setup script can auto-generate this for you
  "JwtSettings": {
    "Key": "",
    "Issuer": "https://markit.com/auth",
    "Audience": "https://markit.com/api",
    "AccessTokenDurationInMinutes": 60,
    "RefreshTokenDurationInMinutes": 10080
  },
  // Default admin user created on first database setup
  // Required fields: UserName (email), Password (min 8 chars, uppercase, lowercase, digit)
  // Setup script can prompt for these values
  "UserDefaultSettings": {
    "UserName": "",
    "Password": ""
  },
  // Optional: Google OAuth authentication
  // Leave empty to disable Google login
  "GoogleAuthSettings": {
    "ClientId": "",
    "ClientSecret": ""
  },
  // Optional: GitHub OAuth authentication
  // Leave empty to disable GitHub login
  "GitHubAuthSettings": {
    "AppName": "",
    "ClientId": "",
    "ClientSecret": ""
  },
  // API rate limiting configuration
  // Configured with sensible defaults for development
  "RateLimiting": {
    "VolumeControl": {
      "PermitLimit": 300,
      "WindowMinutes": 1,
      "WindowSegments": 4
    },
    "ConcurrencyControl": {
      "PermitLimit": 30,
      "QueueLimit": 15
    },
    "DemoLoginQuota": {
      "PermitLimit": 10,
      "WindowHours": 1
    }
  },
  // Logging configuration used by serilog
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/applog-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "ApplicationName": "Markit API"
    }
  }
}