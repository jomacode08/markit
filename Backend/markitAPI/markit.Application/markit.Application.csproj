<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Suppress AutoMapper DoS advisory (GHSA-rvv3-g6hj-g44x: uncontrolled recursion).
      Mitigation is in place: all mappings use BaseProfile.CreateBoundedMap which enforces
      MaxDepth, preventing unbounded recursion at runtime. Upgrade to a patched version
      is blocked by the AutoMapper paid-license constraint.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="13.0.1" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="HtmlSanitizer" Version="9.1.982" />
    <PackageReference Include="Markdig" Version="1.1.3" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.15" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\markit.Domain\markit.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Features\Reports\Dashboard\Queries\ViewModels\" />
  </ItemGroup>

</Project>
